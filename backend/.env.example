# RecoverAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ALL LLM provider keys are OPTIONAL.
# The system works with zero keys via deterministic fallback.

# ============================================================
# DATABASE
# ============================================================
# SQLite (default — no setup needed)
DATABASE_URL=sqlite:///./recoverai.db

# ============================================================
# RAZORPAY (optional — simulation used if not provided)
# Get test keys: https://dashboard.razorpay.com/app/keys
# Test keys start with: rzp_test_
# ============================================================
RAZORPAY_KEY_ID=dummy_key
RAZORPAY_KEY_SECRET=dummy_secret

# ============================================================
# LLM PROVIDERS — Priority: Groq → OpenRouter → Nvidia NIM → OpenAI → Deterministic
# Add any key to enable that provider. All are optional.
# ============================================================

# Groq — FASTEST. Free tier: 14,400 req/day, 6,000 tokens/min
# Get key: https://console.groq.com/
# GROQ_API_KEY=gsk_...

# OpenRouter — 100+ models, free tier available
# Get key: https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-...

# Nvidia NIM — Enterprise open models
# Get key: https://build.nvidia.com/
# NVIDIA_NIM_API_KEY=nvapi-...

# OpenAI — gpt-4o-mini fallback
# Get key: https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# ============================================================
# LLM BEHAVIOR
# ============================================================
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1

# ============================================================
# APP
# ============================================================
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
