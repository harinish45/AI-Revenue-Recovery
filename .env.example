# RecoverAI configuration — read from the repo root by Docker Compose
# (env_file: .env) and by the start.sh/start.bat one-command launcher, which
# copies this into backend/.env. If you're setting the backend up manually
# instead (cd backend && cp .env.example .env), that copy lives at
# backend/.env.example — same variables, kept in sync with this file.
# Grouped to match backend/app/config.py, the source of truth for every
# setting's default and meaning.

# ---------------------------------------------------------------- #
# Environment
# ---------------------------------------------------------------- #
# "development" (default, this file) or "production". Production hard-
# disables demo routes and refuses to boot without API_KEYS + AUDIT_SIGNING_KEY.
APP_ENV=development

# ---------------------------------------------------------------- #
# Database
# ---------------------------------------------------------------- #
DATABASE_URL=sqlite:///./recoverai.db

# ---------------------------------------------------------------- #
# CORS
# ---------------------------------------------------------------- #
# Origins allowed to call this API from a browser. Empty is fine for the
# same-origin standalone cockpit at "/". Running the React dev server
# (npm run dev, http://localhost:5173) needs its own origin added, e.g.:
#   CORS_ORIGINS=["http://localhost:5173"]
# Otherwise its requests silently fail and the UI shows "Backend offline".
CORS_ORIGINS=[]

# ---------------------------------------------------------------- #
# Razorpay / payment provider
# ---------------------------------------------------------------- #
# Leave gateway credentials blank for the safe simulated demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SIMULATE=true

# ---------------------------------------------------------------- #
# Recovery policy & safety thresholds
# ---------------------------------------------------------------- #
MAX_RETRIES=2
MAX_AMOUNT=50000.0
RECOVERY_COST_PER_ATTEMPT=18.0
SMART_SKIP_MIN_AMOUNT=50.0
RETRY_COOLDOWN_FIRST_HOURS=4.0
RETRY_COOLDOWN_HOURS=24.0
AMOUNT_TOLERANCE=0.01

# ---------------------------------------------------------------- #
# Rate limiting
# ---------------------------------------------------------------- #
RATE_LIMIT_EXECUTE=20/minute
RATE_LIMIT_DEMO=10/minute

# ---------------------------------------------------------------- #
# Webhooks
# ---------------------------------------------------------------- #
WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=262144
# JSON array; only these Razorpay event types are accepted.
WEBHOOK_ALLOWED_EVENTS=["payment.failed","payment.captured","payment_link.paid","refund.processed"]

# ---------------------------------------------------------------- #
# Security — API auth and the tamper-evident audit chain
# ---------------------------------------------------------------- #
# Core API auth. Leave empty for the open demo experience outside production.
# Format: ["<key>:<role>", ...] where role is "operator" or "readonly".
# Required (non-empty) when APP_ENV=production, or the app refuses to boot.
API_KEYS=[]
# HMAC key that seals the tamper-evident audit chain. Leave empty in dev/demo
# (a random per-process key is used instead); required when APP_ENV=production.
AUDIT_SIGNING_KEY=
# Max request body size (bytes) accepted on any route, checked from
# Content-Length before the body is read. Webhooks enforce their own
# tighter WEBHOOK_MAX_BODY_BYTES on top of this.
MAX_REQUEST_BODY_BYTES=524288

# ---------------------------------------------------------------- #
# Demo mode — synthetic data, reset, batch, failure simulation.
# Hard-disabled in production regardless of these values.
# ---------------------------------------------------------------- #
DEMO_MODE=true
# Optional shared secret; when set, demo routes also require X-Demo-Token.
DEMO_API_TOKEN=

# ---------------------------------------------------------------- #
# AI-assisted diagnosis (optional) — the deterministic agent always runs
# and the policy engine always has final say; this only lets a model
# *suggest* an action from the same allowlist. Requires both flags below.
# ---------------------------------------------------------------- #
AI_DIAGNOSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
